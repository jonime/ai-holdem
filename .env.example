# Optional canonical public origin for SEO metadata, robots, and sitemap.
# Defaults to https://www.aiholdem.gg, independently of the Vercel deployment hostname.
# Set this to override the canonical domain; use an absolute HTTP(S) URL.
NEXT_PUBLIC_APP_URL=

# Browser-safe Supabase connection details from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials. Never add the NEXT_PUBLIC_ prefix to these values.
SUPABASE_SECRET_KEY=
TYPESAFE_API_KEY=
LLM_API_ENDPOINT=
LLM_API_KEY=

# JSON array of model definitions. Optional reasoning values are none, minimal,
# low, medium, high, and xhigh; omitted reasoning defaults to minimal.
# Example: [{"id":"my-llm","label":"My LLM","modelId":"provider/model","reasoning":"low"}]
LLM_BOT_MODELS=[]

# Set to false in E2E and other cost-free environments. This rejects Jev and
# External LLM requests; deterministic bots continue to work.
EXTERNAL_INFERENCE_ENABLED=true
