# Browser-safe Supabase connection details from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials. Never add the NEXT_PUBLIC_ prefix to these values.
SUPABASE_SECRET_KEY=
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# JSON array of {"id":"...","label":"...","modelId":"..."} profiles.
OPENROUTER_BOT_PROFILES=[]

# Set to false in E2E and other cost-free environments. This rejects Jev and
# OpenRouter requests; deterministic bots continue to work.
EXTERNAL_INFERENCE_ENABLED=true
