{
  "name": "ai-holdem",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "browserslist": [
    "chrome >= 120",
    "edge >= 120",
    "firefox >= 120",
    "safari >= 17"
  ],
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "benchmark:policy": "vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/typesafe-policy.benchmark.ts",
    "benchmark:typesafe:live": "TYPESAFE_LIVE_BENCHMARK=true vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/typesafe-live.live.ts",
    "test:sql:game-reads": "node scripts/local-game-reads.mjs test",
    "benchmark:game-reads": "node scripts/local-game-reads.mjs benchmark",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "node scripts/e2e/smoke.mjs",
    "test:e2e:reset": "supabase db reset --local --yes && playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:bots": "vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/bot-scenarios.benchmark.ts",
    "test:sql:seats": "node scripts/local-seats.mjs",
    "test:sql:bot-claims": "node scripts/local-bot-claims.mjs",
    "test:sql:bot-context": "node scripts/local-bot-context.mjs",
    "benchmark:poker-context": "BOT_SCENARIO_LIVE=false vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/poker-context.benchmark.ts",
    "benchmark:poker-context:live": "BOT_SCENARIO_LIVE=true vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/poker-context.benchmark.ts -t \"capped live\""
  },
  "dependencies": {
    "@hivetech/poker-engine": "1.0.1",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.6",
    "@supabase/supabase-js": "2.117.2",
    "@vercel/speed-insights": "2.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "2.0.14",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
