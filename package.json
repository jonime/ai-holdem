{
  "name": "ai-holdem",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "browserslist": [
    "chrome >= 120",
    "edge >= 120",
    "firefox >= 120",
    "safari >= 17"
  ],
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:benchmarks": "vitest run --config vitest.benchmark-tests.config.ts",
    "benchmark:policy": "vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/typesafe-policy.benchmark.ts",
    "benchmark:typesafe:live": "TYPESAFE_LIVE_BENCHMARK=true vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/typesafe-live.live.ts",
    "test:sql": "node scripts/sql-verification.mjs",
    "test:sql:game-reads": "node scripts/local-game-reads.mjs test",
    "benchmark:game-reads": "node scripts/local-game-reads.mjs benchmark",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "node scripts/e2e/production.mjs smoke",
    "test:e2e:reset": "supabase db reset --local --yes && playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:bots": "vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/bot-scenarios.benchmark.ts",
    "test:sql:departures": "node scripts/local-departures.mjs",
    "test:sql:seats": "node scripts/local-seats.mjs",
    "test:sql:bot-claims": "node scripts/local-bot-claims.mjs",
    "test:sql:bot-context": "node scripts/local-bot-context.mjs",
    "benchmark:poker-context": "BOT_SCENARIO_LIVE=false vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/poker-context.benchmark.ts",
    "benchmark:poker-context:live": "BOT_SCENARIO_LIVE=true vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/poker-context.benchmark.ts -t \"capped live\"",
    "test:sql:removal": "node scripts/local-table-removal.mjs",
    "test:sql:my-games": "node scripts/local-my-games.mjs",
    "test:sql:usage": "node scripts/local-usage-limits.mjs",
    "test:sql:turn-timers": "node scripts/local-turn-timers.mjs",
    "test:e2e:ui": "node scripts/e2e/production.mjs ui",
    "test:e2e:webkit": "node scripts/e2e/production.mjs webkit",
    "test:e2e:ci": "node scripts/e2e/production.mjs ci",
    "test:sql:creation": "node scripts/local-creation-attempts.mjs",
    "db:types:generate": "node scripts/database-types.mjs generate",
    "db:types:check": "node scripts/database-types.mjs check",
    "test:poker:simulation": "node scripts/poker-simulation.mjs",
    "benchmark:jev:heads-up": "BOT_SCENARIO_LIVE=false vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/heads-up/jev-heads-up.benchmark.ts",
    "benchmark:jev:memory:live": "BOT_SCENARIO_LIVE=true vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/heads-up/jev-heads-up.benchmark.ts -t \"capped live memory\"",
    "test:integration:bot-pipeline": "node scripts/bot-pipeline.mjs",
    "benchmark:range-equity": "vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/range-equity/range-equity.benchmark.ts",
    "benchmark:equity-rules": "BOT_SCENARIO_LIVE=false vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/equity-rules/equity-rules.benchmark.ts",
    "benchmark:opponent-advice": "BOT_SCENARIO_LIVE=false vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/opponent-advice/opponent-advice.benchmark.ts",
    "benchmark:opponent-advice:live": "BOT_SCENARIO_LIVE=true vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/opponent-advice/opponent-advice.benchmark.ts -t \"capped paid\"",
    "benchmark:opponent-advice:v2": "BOT_SCENARIO_LIVE=false vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/opponent-advice/controlled-fixtures.benchmark.ts",
    "benchmark:opponent-advice:v2:live": "BOT_SCENARIO_LIVE=true vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/opponent-advice/controlled-pilot.live.ts",
    "benchmark:bot-audit": "BOT_AUDIT_MODE=offline BOT_SCENARIO_LIVE=false EXTERNAL_INFERENCE_ENABLED=false vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/bot-audit/audit.benchmark.ts",
    "benchmark:bot-audit:live": "BOT_AUDIT_MODE=live BOT_SCENARIO_LIVE=true vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts benchmarks/bot-audit/audit.benchmark.ts",
    "benchmark:bot-audit:analyze": "node benchmarks/bot-audit/analyze.mjs",
    "benchmark:bot-improvements": "node benchmarks/bot-improvements/run.mjs offline",
    "benchmark:bot-improvements:prepare": "node benchmarks/bot-improvements/run.mjs prepare",
    "benchmark:bot-improvements:live": "node benchmarks/bot-improvements/run.mjs live",
    "benchmark:bot-improvements:analyze": "node benchmarks/bot-improvements/run.mjs analyze",
    "benchmark:jev-preflop-sizing": "node benchmarks/jev-preflop-sizing/run.mjs",
    "benchmark:preflop-action-value": "node benchmarks/preflop-action-value/run.mjs",
    "benchmark:preflop-action-value:analyze": "node benchmarks/preflop-action-value/run.mjs analyze",
    "benchmark:preflop-candidate": "node benchmarks/preflop-candidate/run.mjs",
    "test:sql:results": "node scripts/local-personal-results.mjs",
    "test:sql:replay": "node scripts/local-hand-replay.mjs",
    "benchmark:bet-sizing": "node benchmarks/bet-sizing/run.mjs offline",
    "benchmark:bet-sizing:prepare": "node benchmarks/bet-sizing/run.mjs prepare",
    "benchmark:bet-sizing:live": "node benchmarks/bet-sizing/run.mjs live",
    "benchmark:bet-sizing:analyze": "node benchmarks/bet-sizing/run.mjs analyze",
    "benchmark:session-adaptation": "node benchmarks/session-adaptation/run.mjs offline",
    "benchmark:session-adaptation:prepare": "node benchmarks/session-adaptation/run.mjs prepare",
    "benchmark:session-adaptation:live": "node benchmarks/session-adaptation/run.mjs live",
    "benchmark:session-adaptation:report": "node benchmarks/session-adaptation/run.mjs report",
    "benchmark:session-adaptation:continue:prepare": "node benchmarks/session-adaptation/run.mjs continue-prepare",
    "benchmark:session-adaptation:continue": "node benchmarks/session-adaptation/run.mjs continue-live",
    "benchmark:session-adaptation:llm:prepare": "node benchmarks/session-adaptation/run.mjs llm-prepare",
    "benchmark:session-adaptation:llm": "node benchmarks/session-adaptation/run.mjs llm-live",
    "benchmark:river-lookahead": "node benchmarks/river-lookahead/run.mjs",
    "test:sql:shares": "node scripts/local-replay-shares.mjs",
    "benchmark:river-candidate": "node benchmarks/river-candidate/run.mjs",
    "benchmark:llm-quarter-pot": "node benchmarks/llm-quarter-pot/reproduce.mjs",
    "test:e2e:deployment": "node scripts/e2e/deployment.mjs"
  },
  "dependencies": {
    "@hivetech/poker-engine": "1.0.1",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.2",
    "@supabase/supabase-js": "2.118.0",
    "@vercel/speed-insights": "2.0.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "2.0.14",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
